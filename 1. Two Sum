class Solution:
    def twoSum(self, nums: list[int], target: int) -> list[int]:
        lists = {}

        for i, num in enumerate(nums):
            complement= target - num

            if complement in lists:
                return[lists[complement], i]
            
            lists[num]= i

# Time Complexity: O(n) We visit every element at most once
# Space Complexity: O(n) In the worst case, there is no answer until the end. Then we store almost every element
